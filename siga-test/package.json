{
  "name": "siga-test",
  "version": "0.9.0",
  "description": "SIGA - Système Intégré de Gestion Administrative (DGREH), version de test connectée",
  "author": "DGREH",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build:web": "node tools/build-web.mjs",
    "icons": "node tools/icons.mjs",
    "android:sync": "npm run build:web && npx cap sync android",
    "win": "npm run build:web && electron-builder --win",
    "start:desktop": "npm run build:web && electron ."
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@supabase/supabase-js": "2.117.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "bf.dgreh.siga.test",
    "productName": "SIGA Test",
    "copyright": "DGREH · Burkina Faso",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "www/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SIGA Test",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "artifactName": "SIGA-Test-${version}-installation.${ext}"
    },
    "portable": {
      "artifactName": "SIGA-Test-${version}-portable.${ext}"
    },
    "publish": null
  }
}